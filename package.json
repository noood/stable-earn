{
  "name": "stablecoin-earn-monitor",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --host localhost --port 3000 --strictPort",
    "build": "vinext build",
    "start": "vinext start --hostname localhost --port 3000",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:file": "node --experimental-strip-types --test",
    "test:e2e": "playwright test",
    "audit:security": "node scripts/audit-security.mjs",
    "verify": "npm run lint && npm run typecheck && npm test",
    "check": "npm run verify && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vinext/cloudflare": "1.0.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "sharp": "0.35.5"
  },
  "type": "module"
}
